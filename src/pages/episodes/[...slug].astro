---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import YouTubePlayer from "../../components/YouTubePlayer.astro";

import emailIcon from "../../assets/images/email-icon.svg";
import facebookIcon from "../../assets/images/facebook-icon.svg";
import linkIcon from "../../assets/images/link-icon.svg";
import youtubeIcon from "../../assets/images/youtube-icon.svg";
import appleIcon from "../../assets/images/apple-icon.svg";
import spotifyIcon from "../../assets/images/spotify-icon.svg";
import xIcon from "../../assets/images/x-icon.svg";
import linkedinIcon from "../../assets/images/linkedin-icon.svg";

export async function getStaticPaths() {
  const entries = await getCollection("episodes");
  entries.sort((a, b) => a.data.number - b.data.number);

  return entries.map((episode, index, arr) => ({
    params: { slug: String(episode.data.number) },
    props: { episode, previous: arr[index - 1], next: arr[index + 1] }
  }));
}

const { episode, previous, next } = Astro.props;
const youtubeUrl = episode.data.youtube ? new URL(episode.data.youtube) : undefined;
const videoId = youtubeUrl?.hostname === "youtu.be"
  ? youtubeUrl.pathname.slice(1)
  : youtubeUrl?.searchParams.get("v") ?? youtubeUrl?.pathname.split("/").at(-1);
const embedUrl = videoId && /^[\w-]{11}$/.test(videoId)
  ? `https://www.youtube-nocookie.com/embed/${videoId}`
  : undefined;
const title = `${episode.data.title} | Ep ${episode.data.number} | Front-End Fire`;
const description = episode.data.teaser || episode.data.description.substring(0, 200) + "...";
const timestamps = episode.data.number === 169 && videoId
  ? (episode.data.chapters ?? []).map((chapter) => ({
      ...chapter,
      url: `https://www.youtube.com/watch?v=${videoId}&t=${chapter.start
        .split(":")
        .reduce((seconds, part) => seconds * 60 + Number(part), 0)}s`
    }))
  : [];
// TODO: Bring back the hosts and guests
// const hosts = await getEntries(episode.data.hosts);
---

<Layout title={title} description={description} contentMaxWidth="80rem">


  <main class:list={{ "without-video": !embedUrl }}>
    <div class="episode-content">
  <header class="episode-header">
    <div class="episode-header-content">
      <div class="episode-title-section">
        <div class="episode-number-display">
          <span class="episode-number">Episode {episode.data.number}</span>
          <span class="episode-date-group">
            <span aria-hidden="true">|</span>
            <time datetime={episode.data.date.toISOString()} class="episode-date">
              {
                episode.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC"
                })
              }
            </time>
          </span>
        </div>
        <h1 class="episode-title">{episode.data.title}</h1>
        <div class="header-accent"></div>
      </div>
    </div>
  </header>
      <p class="episode-teaser">{episode.data.teaser || description}</p>
    </div>

    {
      embedUrl && (
        <div class="episode-sidebar">
          <YouTubePlayer
            videoId={videoId!}
            title={`Watch episode ${episode.data.number}: ${episode.data.title}`}
          />
        </div>
      )
    }
      <div class="episode-actions">
      <div class="listen-section">
        <h3 class="section-heading">Listen</h3>
        <div class="listen-links">
          {
            episode.data.youtube && (
              <a href={episode.data.youtube} target="_blank" title="Listen on YouTube">
                <Image src={youtubeIcon} alt="YouTube" />
                <span>YouTube</span>
              </a>
            )
          }
          {
            episode.data.apple && (
              <a href={episode.data.apple} target="_blank" title="Listen on Apple Podcasts">
                <Image src={appleIcon} alt="Apple Podcasts" />
                <span>Apple</span>
              </a>
            )
          }
          {
            episode.data.spotify && (
              <a href={episode.data.spotify} target="_blank" title="Listen on Spotify">
                <Image src={spotifyIcon} alt="Spotify" />
                <span>Spotify</span>
              </a>
            )
          }
        </div>
      </div>

      <div class="share-section">
        <h3 class="section-heading">Share</h3>
        <div class="share-actions" data-episode-title={episode.data.title}>
          <a
            title="Share on X" aria-label="Share on X"
            target="_blank"
            data-share-platform="x"
            href={Astro.url.pathname}
          >
            <Image src={xIcon} alt="" />
          </a>
          <a
            title="Share on LinkedIn" aria-label="Share on LinkedIn"
            target="_blank"
            rel="noopener noreferrer"
            data-share-platform="linkedin"
            href={Astro.url.pathname}
          >
            <Image src={linkedinIcon} alt="" />
          </a>
          <a
            title="Share via email" aria-label="Share via email"
            data-share-platform="email"
            href={Astro.url.pathname}
          >
            <Image src={emailIcon} alt="" />
          </a>
          <a
            title="Share on Facebook" aria-label="Share on Facebook"
            target="_blank"
            data-share-platform="facebook"
            href={Astro.url.pathname}
          >
            <Image src={facebookIcon} alt="" />
          </a>
          <div class="copy-link-container">
            <button
              title="Copy Episode Link" aria-label="Copy Episode Link"
              class="copy-episode-link-action"
              type="button"
            >
              <Image src={linkIcon} alt="" />
            </button>
            <div id="copy-link-status" role="status" aria-live="polite"></div>
          </div>
        </div>
      </div>
      </div>

    <div class="episode-extras">
      {
        timestamps.length > 0 && (
          <section class="timestamps-section" aria-labelledby="timestamps-heading">
            <h2 class="section-heading" id="timestamps-heading">Timestamps</h2>
            <ul class="timestamp-list">
              {timestamps.map((chapter) => (
                <li>
                  <a href={chapter.url} target="_blank" rel="noopener noreferrer">
                    <span class="timestamp-time">{chapter.start}</span>
                    <span>{chapter.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <h2 class="section-heading">Full Description</h2>
      <p class="episode-description">
        {episode.data.description}
      </p>

      <div class="episode-links-section">
         <h2 class="section-heading">Links</h2>
         <ul class="episode-links">
           {
             episode.data.links.map((link) => (
               <li>
                 <a href={link.url} target="_blank">
                   {link.text}
                 </a>
               </li>
             ))
           }
         </ul>
       </div>
    </div>

    <nav class="episode-nav">
      {
        previous && (
          <a
            href={"/episodes/" + previous.data.number}
            class="previous-episode-nav-link"
          >
            <span>
              ep. {previous.data.number}: {previous.data.title}
            </span>
          </a>
        )
      }
      {
        next && (
          <a
            href={"/episodes/" + next.data.number}
            class="next-episode-nav-link"
          >
            <span>
              ep. {next.data.number}: {next.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </main>

  <Footer />
</Layout>

<script>
  // Resolve in the browser so static builds share the actual page URL and origin.
  const shareActions = document.querySelector<HTMLElement>(".share-actions");
  const episodeTitle = shareActions?.dataset.episodeTitle ?? document.title;
  const shareUrl = location.href;
  const shareLinks: Record<string, string> = {
    x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(`${episodeTitle}\r\n${shareUrl}`)}`,
    linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
    email: `mailto:?subject=${encodeURIComponent(episodeTitle)}&body=${encodeURIComponent(`Check out this episode from the Front-End Fire podcast\r\n\r\n${shareUrl}`)}`,
    facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`
  };

  shareActions?.querySelectorAll<HTMLAnchorElement>("[data-share-platform]").forEach((link) => {
    const href = shareLinks[link.dataset.sharePlatform ?? ""];
    if (href) link.href = href;
  });

  const copyButton = document.querySelector<HTMLButtonElement>(".copy-episode-link-action");
  const copyStatus = document.getElementById("copy-link-status");
  let dismissTimer: number | undefined;

  copyButton?.addEventListener("click", async () => {
    if (!copyStatus) return;
    window.clearTimeout(dismissTimer);

    try {
      await navigator.clipboard.writeText(location.href);
      copyStatus.textContent = "Copied!";
    } catch {
      copyStatus.textContent = "Couldn’t copy link. Please try again.";
    }

    dismissTimer = window.setTimeout(() => {
      copyStatus.textContent = "";
    }, 5000);
  });
</script>

<style>
  .episode-header {
    margin-bottom: 1.5rem;
    color: var(--base-color-dark);
  }

  main {
    width: var(--content-width);
    max-width: var(--max-width);
    margin: 2.5rem auto 0;
  }

  .episode-number-display {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1rem;
    font-size: 1.125rem;
  }

  .episode-number {
    color: var(--primary-color-dark);
    font-weight: 500;
  }

  .episode-date {
    color: #66616b;
  }

  .episode-date-group {
    display: inline-flex;
    align-items: baseline;
    gap: 1.5rem;
    white-space: nowrap;
    color: #66616b;
  }

  .episode-title {
    max-width: 24ch;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 200;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .header-accent {
    width: 60px;
    height: 4px;
    background: var(--primary-color);
    border-radius: 2px;
    margin-top: 1.5rem;
  }

  main {
    display: grid;
    grid-template-areas:
      "content sidebar"
      "actions actions"
      "extras extras"
      "nav nav";
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 2.5rem;
  }

  main.without-video {
    grid-template-areas: "content" "actions" "extras" "nav";
    grid-template-columns: minmax(0, 1fr);
  }

  .episode-content {
    grid-area: content;
    align-self: start;
  }

  .episode-teaser {
    margin: 0;
    font-size: clamp(1.4rem, 2vw, 1.875rem);
    line-height: 1.55;
    color: var(--base-color-dark);
  }

  .episode-sidebar {
    grid-area: sidebar;
    min-width: 0;
    align-self: center;
  }

  .episode-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .listen-section,
  .share-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 100%;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    background: #f4ede5;
    color: var(--base-color);
  }

  .episode-actions .section-heading {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: #66616b;
    text-decoration: none;
  }

  .share-actions,
  .listen-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .share-actions a,
  .listen-links a,
  .copy-episode-link-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--base-color);
    text-decoration: none;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    line-height: 1.5;
  }

  .listen-links img,
  .share-actions img {
    height: 1.25em;
    width: 1.25em;
    filter: none;
    display: block;
    flex-shrink: 0;
  }

  .copy-episode-link-action {
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .share-actions {
    gap: 0.25rem;
  }

  .share-actions a,
  .share-actions button {
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.5rem;
    border-radius: 50%;
  }

  .episode-actions a:hover,
  .episode-actions button:hover {
    color: var(--primary-color-dark);
    text-decoration: underline;
  }

  .share-actions a:hover,
  .share-actions button:hover {
    background: #e8ddd0;
  }

  .episode-actions a:focus-visible,
  .episode-actions button:focus-visible {
    outline: 2px solid var(--primary-color-light);
    outline-offset: 4px;
  }

  .copy-link-container {
    position: relative;
  }

  #copy-link-status {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    z-index: 1;
    width: max-content;
    max-width: min(18rem, 75vw);
    padding: 0.35rem 0.65rem;
    background: white;
    color: var(--base-color-dark);
    font-size: 0.875rem;
    border: 1px solid var(--primary-color-dark);
    border-radius: 4px;
    box-shadow: 0 2px 8px #0003;
    pointer-events: none;
  }

  #copy-link-status:empty {
    display: none;
  }

  .episode-extras {
    grid-area: extras;
    width: 100%;
    max-width: 75ch;
  }

  .episode-extras .section-heading {
    margin-top: 0;
  }

  .episode-description {
    white-space: pre-line;
    margin: 0;
    font-size: clamp(1.125rem, 1.4vw, 1.375rem);
    line-height: 1.75;
  }

  .timestamps-section {
    margin-bottom: 2.5rem;
  }

  .timestamp-list {
    list-style: disc;
    margin: 0;
    padding-left: 1.5em;
  }

  .timestamp-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    line-height: 1.5;
  }

  .timestamp-time {
    flex-shrink: 0;
    min-width: 5ch;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .episode-links-section {
    margin-top: 2.5rem;
  }

  .episode-links {
    margin: 1rem 0 0;
    padding-left: 1.25em;
    overflow-wrap: anywhere;
  }

  .episode-links li {
    margin-bottom: 0.75rem;
  }

  .episode-nav {
    grid-area: nav;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  [class$="episode-nav-link"] {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    width: 33%;
    font-weight: 400;

    &::before,
    &::after {
      display: inline-block;
      vertical-align: 0.1em;
      font-weight: 500;
      font-size: 1.5em;
      font-family: monospace;
    }

    & span {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }
  }

  .previous-episode-nav-link::before {
    content: "\2190";
    margin-left: -0.85em;
  }

  .next-episode-nav-link {
    margin-left: auto;

    &::after {
      content: "\2192";
      margin-right: -0.85em;
    }
  }

  @media (max-width: 900px) {
    main {
      grid-template-areas: "content" "sidebar" "actions" "extras" "nav";
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .episode-actions {
      gap: 1rem;
    }
  }

  @media (max-width: 600px) {
    .episode-header {
      margin-bottom: 1.5rem;
    }

    .listen-section,
    .share-section {
      padding: 1rem;
    }

    .listen-links {
      gap: 0.5rem 1rem;
    }
  }
</style>
