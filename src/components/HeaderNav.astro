---
import { Image } from "astro:assets";
import logo from "../assets/images/logo-horizontal.svg";
const pathname = Astro.url.pathname.replace(/\/$/, "");
---

<nav aria-label="Main navigation">
  <a href="/" class="home-link" aria-label="Front-End Fire home">
    <Image src={logo} alt="" />
    <span>Front-End Fire</span>
  </a>
  <div class="nav-links">
    <a href="/all" aria-current={pathname === "/all" ? "page" : undefined}>Episodes</a>
    <a href="/about" aria-current={pathname === "/about" ? "page" : undefined}>About</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    font-size: 0.9375rem;
  }

  a,
  a:visited {
    display: inline-block;
    padding: 0.5rem 0;
    color: var(--off-white);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--off-white);
    font-size: clamp(1rem, 2vw, 1.125rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .home-link img {
    height: 2rem;
    width: auto;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }

  a:hover,
  a[aria-current="page"] {
    color: var(--primary-color-light);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  a:focus-visible {
    outline: 2px solid var(--primary-color-light);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
